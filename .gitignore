# ============================================================
# OSA Observatory — .gitignore
# Mis a jour : Sprint 26 — 23 juin 2026
# ============================================================

# ── Archives de travail ──────────────────────────────────────
*.zip
*.tar.gz
*.tar.bz2

# ── Fichiers de diagnostic temporaires ──────────────────────
*_b64.txt
pre_audit_check.sh
r_*.txt
result*.txt
audit_p7i_long_search.txt
project_tree.csv
r_endpoints.txt

# ── Patches de travail ──────────────────────────────────────
*.diff
*.patch

# ── Variantes de routers non integrees ──────────────────────
api/routers/*_FIXED.py
api/routers/*_GENECO*.py

# ── Fichiers SQL de travail a la racine ──────────────────────
/*.sql

# ── Exports temporaires ──────────────────────────────────────
exports/
backup_*.csv

# ── Donnees de collecte (non versionnees) ───────────────────
# Les donnees sources brutes sont gerees hors depot.
# Reproductibilite assuree par les collecteurs (collectors/).
data/raw/
data/manual/
data/osa-data/
collectors/data/

# ── Mapping / activation (fichiers de travail) ───────────────
mapping/activation/

# ── Requetes de diagnostic DB ────────────────────────────────
# Conserver db/patch_db/ et db/to_indicator_value/ (commites)
# Exclure les requetes ad hoc
db/requete_db/

# ── Sorties d'execution (non livrables) ─────────────────────
audit/reports/json/
audit/reports/*.json
audit/reports/*.csv

# ── Python ──────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/

# ── Environnements virtuels ──────────────────────────────────
.venv/
venv/
env/
ENV/

# ── IDE ──────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Secrets / credentials ────────────────────────────────────
*.pem
*.key
*.p12
.env
.env.*
!.env.example
secrets/
credentials/

# ── Logs ─────────────────────────────────────────────────────
*.log
logs/

# ── Node (portal) ────────────────────────────────────────────
node_modules/
npm-debug.log*
