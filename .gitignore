# ============================================================
# OSA Observatory — .gitignore
# Mis a jour : Sprint 26 — 23 juin 2026
# ============================================================

# ── Archives de travail ──────────────────────────────────────
*.zip
*.tar.gz
*.tar.bz2

# ── Fichiers de diagnostic temporaires ──────────────────────
*_b64.txt
check_l3_b64.txt
pre_audit_check.sh

# ── Patches de travail ──────────────────────────────────────
*.diff
*.patch

# ── Variantes de routers non integrees ──────────────────────
api/routers/*_FIXED.py
api/routers/*_GENECO*.py

# ── Sorties d'execution (non livrables) ─────────────────────
audit/reports/json/
audit/reports/*.json
audit/reports/*.csv

# ── Python ──────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# ── Environnements virtuels ──────────────────────────────────
.venv/
venv/
env/
ENV/

# ── IDE ──────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS ───────────────────────────────────────────────────────
.DS_Store
.DS_Store?
Thumbs.db
desktop.ini

# ── Secrets / credentials ────────────────────────────────────
# (defense en profondeur — les cles ne doivent jamais etre
#  dans le depot, meme accidentellement)
*.pem
*.key
*.p12
.env
.env.*
!.env.example
secrets/
credentials/

# ── Logs ─────────────────────────────────────────────────────
*.log
logs/

# ── Node (portal) ────────────────────────────────────────────
node_modules/
npm-debug.log*
