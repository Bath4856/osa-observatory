{
  "name": "OSA / ISA Observatory",

  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/osa-observatory",

  // Extensions VS Code installées automatiquement
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.black-formatter",
        "mtxr.sqltools",
        "mtxr.sqltools-driver-pg",
        "redhat.vscode-yaml",
        "ms-azuretools.vscode-docker",
        "eamodio.gitlens",
        "streetsidesoftware.code-spell-checker-french"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.formatting.provider": "black",
        "editor.formatOnSave": true,
        "editor.rulers": [88],
        "sqltools.connections": [
          {
            "name": "OSA Local",
            "driver": "PostgreSQL",
            "server": "db",
            "port": 5432,
            "database": "osa_db",
            "username": "osa_user",
            "password": "osa_pass"
          }
        ]
      }
    }
  },

  // Ports exposés automatiquement
  "forwardPorts": [5432, 8501],
  "portsAttributes": {
    "5432": { "label": "PostgreSQL OSA" },
    "8501": { "label": "Streamlit Dashboard" }
  },

  // Script exécuté au premier démarrage du container
  "postCreateCommand": "bash .devcontainer/setup.sh",

  // Variables d'environnement injectées dans le container app
  "remoteEnv": {
    "OSA_DB_HOST": "db",
    "OSA_DB_PORT": "5432",
    "OSA_DB_NAME": "osa_db",
    "OSA_DB_USER": "osa_user",
    "OSA_DB_PASS": "osa_pass",
    "OSA_LOG_LEVEL": "INFO",
    "PYTHONPATH": "/workspace/collectors"
  }
}
